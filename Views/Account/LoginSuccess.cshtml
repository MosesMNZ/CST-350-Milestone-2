@{
    ViewData["Title"] = "Login Successful";
}

<div class="d-flex justify-content-center align-items-center" style="height: 100%;">
    <div class="col-md-5 col-sm-8 col-11 text-center">
        <div class="alert alert-success" role="alert">
            <h4 class="alert-heading">Success!</h4>
            <p>You have been logged in successfully.</p>
            <hr />
            <p class="mb-0">Welcome back! You can now access your account.</p>
        </div>
        <a href="@Url.Action("StartGame", "Games")" class="btn btn-primary">Play the Game</a>
    </div>
</div>
