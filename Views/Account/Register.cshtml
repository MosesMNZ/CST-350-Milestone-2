@model RegisterModel

@{
    ViewData["Title"] = "User Registration";
}

<div class="d-flex justify-content-center align-items-center" style="height: 100%;">
    <div class="col-md-6 col-sm-10 col-11">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body py-2 px-3">
                <form method="post" asp-action="Register" asp-controller="Account">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label asp-for="FirstName" class="form-label small mb-0">First Name</label>
                            <input asp-for="FirstName" class="form-control form-control-sm" placeholder="First name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label asp-for="LastName" class="form-label small mb-0">Last Name</label>
                            <input asp-for="LastName" class="form-control form-control-sm" placeholder="Last name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label asp-for="Sex" class="form-label small mb-0">Sex</label>
                            <select asp-for="Sex" class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Sex" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label asp-for="Age" class="form-label small mb-0">Age</label>
                            <input asp-for="Age" type="number" class="form-control form-control-sm" placeholder="Age" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label asp-for="State" class="form-label small mb-0">State</label>
                        <input asp-for="State" class="form-control form-control-sm" placeholder="State" />
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Email" class="form-label small mb-0">Email</label>
                        <input asp-for="Email" type="email" class="form-control form-control-sm" placeholder="Email address" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Username" class="form-label small mb-0">Username</label>
                        <input asp-for="Username" class="form-control form-control-sm" placeholder="Username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small mb-0">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-sm" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-sm">Register</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
