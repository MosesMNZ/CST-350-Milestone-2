@{
    ViewData["Title"] = "Registration Successful";
}

<div class="d-flex justify-content-center align-items-center" style="height: 100%;">
    <div class="col-md-5 col-sm-8 col-11 text-center">
        <div class="alert alert-success" role="alert">
            <h4 class="alert-heading">Success!</h4>
            <p>Your registration has been completed successfully.</p>
            <hr />
            <p class="mb-0">Welcome! You can now log in with your credentials.</p>
        </div>
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary mt-2">Go to Login</a>
    </div>
</div>
