@model GameSettingsModel

@{
    ViewData["Title"] = "Start Game - Minesweeper";
}

<div class="d-flex justify-content-center align-items-center" style="height: 100%;">
    <div class="col-md-5 col-sm-8 col-11">
        <div class="card shadow-lg">
            <div class="card-body">
                <h2 class="card-title text-center mb-3">Start New Game</h2>

                <form method="post" action="@Url.Action("StartGame", "Games")">
                    <div class="mb-3">
                        <label asp-for="BoardSize" class="form-label fw-bold"></label>
                        <select asp-for="BoardSize" class="form-select">
                            <option value="" selected disabled>Select board size...</option>
                            <option value="8">8x8 Board (64 cells)</option>
                            <option value="10">10x10 Board (100 cells)</option>
                            <option value="12">12x12 Board (144 cells)</option>
                        </select>
                        <small class="text-muted">Choose board dimensions</small>
                        <span asp-validation-for="BoardSize" class="text-danger d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Difficulty" class="form-label fw-bold"></label>
                        <select asp-for="Difficulty" class="form-select">
                            <option value="" selected disabled>Select difficulty...</option>
                            <option value="Easy">Easy - Fewer mines</option>
                            <option value="Medium">Medium - Balanced</option>
                            <option value="Hard">Hard - Many mines</option>
                        </select>
                        <small class="text-muted">Higher difficulty has more mines</small>
                        <span asp-validation-for="Difficulty" class="text-danger d-block"></span>
                    </div>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <button type="submit" class="btn btn-primary">Start Game</button>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
