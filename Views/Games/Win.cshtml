@{
    ViewData["Title"] = "You Won!";
}

<div class="d-flex justify-content-center align-items-center" style="height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 12px;">
    <div class="card shadow-lg" style="width: 100%; max-width: 480px;">
        <div class="card-body p-4 text-center">

            <!-- Victory Icon -->
            <div style="font-size: 48px; margin-bottom: 8px;">🎉</div>

            <!-- Main Message -->
            <h1 class="card-title mb-1" style="color: #28a745; font-weight: bold; font-size: 1.8em;">Congratulations!</h1>
            <p class="card-text mb-3" style="color: #555; font-size: 1em;">You won the game! 🏆</p>

            <!-- Stats Card -->
            <div class="card mb-3" style="border: 2px solid #28a745; background-color: #f8f9fa;">
                <div class="card-body py-2 px-3">
                    <h6 class="card-title mb-2" style="color: #333;">Game Statistics</h6>
                    <div class="d-flex justify-content-around">
                        <div>
                            <p class="text-muted mb-0" style="font-size: 0.75em;">Final Score</p>
                            <h5 class="mb-0" style="color: #0d6efd; font-weight: bold;">@(ViewBag.Score ?? 0) pts</h5>
                        </div>
                        <div>
                            <p class="text-muted mb-0" style="font-size: 0.75em;">Time</p>
                            @{
                                int winSecs = (int)(ViewBag.ElapsedSeconds ?? 0);
                                int winMins = winSecs / 60;
                                int winRemSecs = winSecs % 60;
                            }
                            <h5 class="mb-0" style="color: #28a745; font-weight: bold;">@(winMins):@(winRemSecs.ToString("D2"))</h5>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional Stats -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <div style="background-color: #f0f7ff; padding: 10px; border-radius: 4px; border-left: 4px solid #0d6efd;">
                        <p class="text-muted small mb-1">Board Size</p>
                        <h6 class="mb-0" style="color: #0d6efd; font-weight: bold;">@(ViewBag.BoardSize ?? 8) × @(ViewBag.BoardSize ?? 8)</h6>
                    </div>
                </div>
                <div class="col-6">
                    <div style="background-color: #f0fff4; padding: 10px; border-radius: 4px; border-left: 4px solid #28a745;">
                        <p class="text-muted small mb-1">Difficulty</p>
                        <h6 class="mb-0" style="color: #28a745; font-weight: bold;">@(ViewBag.Difficulty ?? "Easy")</h6>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-grid gap-2">
                <a href="@Url.Action("RestartGame", "Games")" class="btn btn-success" style="font-weight: bold;">
                    🎮 Try Again
                </a>
                <a href="@Url.Action("StartGame", "Games")" class="btn btn-outline-secondary" style="font-weight: bold;">
                    🗂️ Change Board
                </a>
            </div>

        </div>
    </div>
</div>
